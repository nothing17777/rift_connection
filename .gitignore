# Workspace-level gitignore
.agent/

# OS-specific / Editor files
**/.DS_Store
**/*.pem
Thumbs.db

# Ignore build outputs, dependencies, and temporary files of any subfolders/projects
**/node_modules/
**/.next/
**/*.tsbuildinfo
**/out/
**/build/
**/dist/
**/coverage/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.env*.local
**/.vercel
**/dev.log
**/uistuff.txt
